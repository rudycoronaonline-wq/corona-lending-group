---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
if (!entry) {
  return Astro.redirect('/blog');
}

const { Content } = await render(entry);
function formatCategory(cat) {
  if (cat === 'seniors') return 'Seniors';
  if (cat === 'first-time-buyers') return 'First-Time Buyers';
  if (cat === 'investors') return 'Investors';
  return cat.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
const categoryLabel = formatCategory(entry.data.category);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/png" />
    <title>{entry.data.title} | Corona Lending Group</title>
    <meta name="description" content={entry.data.description} />
    <style is:global>
      main.post-page .post-content h2 { color: #0284c7 !important; font-size: 1.5rem !important; font-weight: 700 !important; }
      main.post-page .post-content h3 { color: #0284c7 !important; font-size: 1.25rem !important; font-weight: 600 !important; }
    </style>
  </head>
  <body>
    <main class="post-page">
      <article>
        <header class="post-header post-header-above">
          <span class="post-category">{categoryLabel}</span>
          <h1 class="post-title">{entry.data.title}</h1>
          <p class="post-meta">
            By Rudy Corona · <time datetime={entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date}>
              {(entry.data.date instanceof Date ? entry.data.date : new Date(entry.data.date)).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </p>
        </header>
        {(() => {
          const imageSrc = entry.data.image ?? (entry.data.category === 'seniors' ? '/images/Blog-Reverse-mortgage.png' : '/images/blog-placeholder.png');
          const imageUrl = imageSrc.includes('%') ? imageSrc : encodeURI(imageSrc);
          return (
            <div class="post-hero-image">
              <img src={imageUrl} alt="" />
            </div>
          );
        })()}
        {entry.data.toc && entry.data.toc.length > 0 && (
          <nav class="post-toc" aria-label="Contents" style="margin: 0 0 2rem; padding: 1.25rem 1.5rem; background: #f8fafc; border-radius: 0.375rem; border: 1px solid #e2e8f0; border-left: 4px solid #0284c7;">
            <h2 class="post-toc-title" style="font-size: 1.125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #0284c7; margin: 0 0 1rem;">Contents</h2>
            <ul class="post-toc-list" style="list-style: disc; margin: 0; padding-left: 1.5rem;">
              {entry.data.toc.map((item) => (
                <li style="margin-bottom: 0.5rem; line-height: 1.5;">
                  <a href={`#${item.slug}`} style="color: #0284c7; text-decoration: none; font-size: 1.125rem; font-weight: 600;">{item.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="post-content blog-content">
          <Content />
        </div>
      </article>
      <p class="back-link"><a href="/blog">← Back to blog</a></p>
    </main>
  </body>
</html>

<style is:global>
  .post-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
  }
  .post-hero-image {
    margin: 0 -1.5rem 1.25rem;
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #e5e7eb;
  }
  .post-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .post-toc {
    margin: 0 0 2rem;
    padding: 1.25rem 1.5rem;
    background: #f8fafc;
    border-radius: 0.375rem;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #0284c7;
  }
  .post-toc .post-toc-title {
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0284c7;
    margin: 0 0 1rem;
  }
  .post-toc .post-toc-list {
    list-style: disc;
    margin: 0;
    padding-left: 1.5rem;
  }
  .post-toc .post-toc-list li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .post-toc .post-toc-list a {
    color: #0284c7 !important;
    text-decoration: none;
    font-size: 1.125rem !important;
    font-weight: 600;
  }
  .post-toc .post-toc-list a:hover {
    text-decoration: underline;
  }
  .post-header {
    margin-bottom: 2.25rem;
  }
  .post-header-above {
    margin-bottom: 1rem;
  }
  .post-category {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1b3a6b;
  }
  .post-header h1,
  .post-title {
    font-size: 1.875rem;
    line-height: 1.25;
    margin: 0.5rem 0 0.25rem;
    color: #1b3a6b;
  }
  .post-title {
    margin-bottom: 2.25rem;
  }
  .post-meta {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
  }
  .post-content {
    line-height: 1.75;
    color: #334155;
  }
  .post-content.blog-content p,
  .blog-content p {
    margin-bottom: 1.5em;
    margin-top: 0;
    line-height: 1.8;
    color: #334155;
  }
  .post-content.blog-content p + p,
  .blog-content p + p {
    margin-top: 0;
  }
  .blog-content :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    color: #1b3a6b;
  }
  main .post-content h2,
  .blog-content :global(h2) {
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    margin-top: 2em;
    margin-bottom: 0.6em;
    line-height: 1.35;
    color: #0284c7 !important;
  }
  .blog-content :global(h2:first-child) {
    margin-top: 0;
  }
  main .post-content h3,
  .blog-content :global(h3) {
    font-size: 1.25rem !important;
    font-weight: 600 !important;
    margin-top: 1.5em;
    margin-bottom: 0.45em;
    color: #0284c7 !important;
  }
  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin: 1em 0 1.35em;
    padding-left: 1.5em;
  }
  .blog-content :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.6;
  }
  .blog-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25em 0;
    font-size: 0.9rem;
  }
  .blog-content :global(th),
  .blog-content :global(td) {
    border: 1px solid #e2e8f0;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .blog-content :global(th) {
    background: #f1f5f9;
    font-weight: 600;
    color: #1b3a6b;
  }
  .blog-content :global(strong) {
    font-weight: 600;
  }
  .blog-content :global(a) {
    color: #1b3a6b;
    text-decoration: underline;
  }
  .back-link {
    margin-top: 2.5rem;
  }
  .back-link a {
    color: #1b3a6b;
    text-decoration: none;
  }
  .back-link a:hover {
    text-decoration: underline;
  }
</style>
