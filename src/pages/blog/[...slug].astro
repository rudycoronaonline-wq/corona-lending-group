---
import { getCollection, getEntry, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    return { params: { slug } };
  });
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;
if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('blog', slug);
if (!entry) {
  return Astro.redirect('/blog');
}

const { Content } = await render(entry);
function formatCategory(cat) {
  if (cat === 'seniors') return 'Seniors';
  if (cat === 'first-time-buyers') return 'First-Time Buyers';
  if (cat === 'investors') return 'Investors';
  return cat.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
const categoryLabel = formatCategory(entry.data.category);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/png" />
    <title>{entry.data.title} | Corona Lending Group</title>
    <meta name="description" content={entry.data.description} />
  </head>
  <body>
    <main class="post-page">
      <article>
        {(() => {
          const imageSrc = entry.data.image ?? (entry.data.category === 'seniors' ? '/images/Blog-Reverse-mortgage.png' : '/images/blog-placeholder.png');
          const imageUrl = imageSrc.includes('%') ? imageSrc : encodeURI(imageSrc);
          return (
            <div class="post-hero-image">
              <img src={imageUrl} alt="" />
            </div>
          );
        })()}
        <header class="post-header">
          <span class="post-category">{categoryLabel}</span>
          <h1>{entry.data.title}</h1>
          <p class="post-meta">
            By Rudy Corona · <time datetime={entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date}>
              {(entry.data.date instanceof Date ? entry.data.date : new Date(entry.data.date)).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </p>
        </header>
        <div class="post-content blog-content">
          <Content />
        </div>
      </article>
      <p class="back-link"><a href="/blog">← Back to blog</a></p>
    </main>
  </body>
</html>

<style is:global>
  .post-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .post-hero-image {
    margin: 0 -1.5rem 1.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #e0f2fe;
  }
  .post-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .post-header {
    margin-bottom: 2rem;
  }
  .post-category {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0284c7;
  }
  .post-header h1 {
    font-size: 1.875rem;
    line-height: 1.2;
    margin: 0.5rem 0;
  }
  .post-meta {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }
  .post-content {
    line-height: 1.7;
  }
  .post-content.blog-content p,
  .blog-content p {
    margin-bottom: 1.25em;
    margin-top: 0;
    line-height: 1.7;
  }
  .post-content.blog-content p + p,
  .blog-content p + p {
    margin-top: 0;
  }
  .blog-content :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .blog-content :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    margin-top: 1.75em;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }
  .blog-content :global(h2:first-child) {
    margin-top: 0;
  }
  .blog-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.25em;
    margin-bottom: 0.4em;
  }
  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin: 0.75em 0 1.25em;
    padding-left: 1.5em;
  }
  .blog-content :global(li) {
    margin-bottom: 0.5em;
  }
  .blog-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 0.9rem;
  }
  .blog-content :global(th),
  .blog-content :global(td) {
    border: 1px solid #e5e7eb;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .blog-content :global(th) {
    background: #f3f4f6;
    font-weight: 600;
  }
  .blog-content :global(strong) {
    font-weight: 600;
  }
  .blog-content :global(a) {
    color: #0284c7;
    text-decoration: underline;
  }
  .back-link {
    margin-top: 2.5rem;
  }
  .back-link a {
    color: #0284c7;
    text-decoration: none;
  }
  .back-link a:hover {
    text-decoration: underline;
  }
</style>
