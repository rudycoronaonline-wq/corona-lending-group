  <style is:inline>
    :root {
      --navy:        #1B3A6B;
      --navy-deep:   #112448;
      --sky:         #4A90D9;
      --sky-light:   #E8F4FD;
      --sand:        #F5F0E8;
      --sand-dark:   #E8DFD0;
      --text:        #1A1A2E;
      --text-muted:  #5A6475;
      --white:       #FFFFFF;
      --gold:        #C9A84C;
      --font-display:'Cormorant Garamond', Georgia, serif;
      --font-body:   'DM Sans', system-ui, sans-serif;
      --radius: 12px;
      --shadow: 0 4px 24px rgba(27,58,107,0.10);
      --shadow-lg: 0 12px 48px rgba(27,58,107,0.16);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); color: var(--text); background: var(--white); line-height: 1.6; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }
    .container { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }
    .topbar { background: var(--navy-deep); color: rgba(255,255,255,0.75); font-size: 0.78rem; padding: 0.45rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .topbar a { color: rgba(255,255,255,0.9); transition: color 0.15s; }
    .topbar a:hover { color: var(--gold); }
    .site-nav { background: var(--navy); padding: 0 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 16px rgba(0,0,0,0.25); min-height: 64px; }
    .nav-logo { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: #fff; white-space: nowrap; flex-shrink: 0; }
    .nav-logo span { color: var(--gold); }
    .nav-links { display: flex; align-items: center; gap: 0.05rem; list-style: none; }
    .nav-links a { color: rgba(255,255,255,0.82); font-size: 0.82rem; font-weight: 500; padding: 0.4rem 0.55rem; border-radius: 5px; white-space: nowrap; transition: color 0.15s, background 0.15s; }
    .nav-links a:hover { color: #fff; background: rgba(255,255,255,0.07); }
    .nav-links .nav-cta { background: var(--gold); color: var(--navy-deep) !important; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 700 !important; margin-left: 0.4rem; }
    .nav-links .nav-cta:hover { filter: brightness(1.1); }
    .menu-btn { display: none; background: none; border: none; cursor: pointer; padding: 0.5rem; flex-direction: column; gap: 5px; }
    .menu-btn span { display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px; }
    .hero { min-height: 76vh; display: flex; align-items: center; position: relative; overflow: hidden; }
    .hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 90px; background: linear-gradient(to top, var(--white), transparent); }
    .hero-inner { position: relative; z-index: 2; padding: 5rem 1.5rem 6.5rem; max-width: 1160px; margin: 0 auto; width: 100%; }
    .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(201,168,76,0.18); border: 1px solid rgba(201,168,76,0.4); color: var(--gold); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.38rem 0.9rem; border-radius: 100px; margin-bottom: 1.25rem; }
    .hero h1 { font-family: var(--font-display); font-size: clamp(2.1rem, 5vw, 4.5rem); font-weight: 700; color: #fff; line-height: 1.08; margin-bottom: 1.25rem; max-width: 820px; }
    .hero h1 em { font-style: italic; color: var(--gold); }
    .hero-sub { font-size: 1.1rem; color: rgba(255,255,255,0.83); max-width: 580px; margin-bottom: 2.25rem; font-weight: 300; line-height: 1.72; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
    .btn-hero-primary { background: var(--gold); color: var(--navy-deep); padding: 0.9rem 2rem; border-radius: 8px; font-weight: 700; font-size: 1rem; transition: filter 0.15s, transform 0.15s; display: inline-block; }
    .btn-hero-primary:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .btn-hero-outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.45); padding: 0.9rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1rem; transition: border-color 0.15s, background 0.15s; display: inline-block; }
    .btn-hero-outline:hover { border-color: #fff; background: rgba(255,255,255,0.07); }
    .hero-stats { display: flex; gap: 2.5rem; margin-top: 3.5rem; flex-wrap: wrap; }
    .hero-stat { border-left: 2px solid var(--gold); padding-left: 1rem; }
    .hero-stat-value { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: #fff; line-height: 1; }
    .hero-stat-label { font-size: 0.78rem; color: rgba(255,255,255,0.62); margin-top: 0.2rem; }
    .section-label { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky); margin-bottom: 0.55rem; }
    .section-title { font-family: var(--font-display); font-size: clamp(1.9rem, 3.8vw, 2.9rem); font-weight: 700; color: var(--navy); line-height: 1.15; margin-bottom: 0.75rem; }
    .section-sub { font-size: 1.02rem; color: var(--text-muted); max-width: 580px; line-height: 1.65; }
    .section-header { margin-bottom: 3rem; }
    .intro-section { padding: 4.5rem 0 3rem; background: var(--white); }
    .intro-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 4rem; align-items: center; }
    .intro-text p { color: var(--text-muted); line-height: 1.82; font-size: 1.02rem; margin-bottom: 1.1rem; }
    .intro-text strong { color: var(--text); }
    .intro-badges { display: flex; flex-direction: column; gap: 1rem; }
    .intro-badge { background: var(--sand); border-radius: var(--radius); padding: 1.2rem 1.4rem; border-left: 4px solid var(--gold); }
    .intro-badge-value { font-family: var(--font-display); font-size: 1.65rem; font-weight: 700; color: var(--navy); line-height: 1; }
    .intro-badge-label { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem; font-weight: 500; }
    .loans-section { padding: 5rem 0; background: var(--sand); }
    .loans-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
    .loan-card { background: var(--white); border-radius: var(--radius); padding: 1.9rem 1.5rem; box-shadow: var(--shadow); transition: transform 0.2s, box-shadow 0.2s; position: relative; overflow: hidden; }
    .loan-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--navy); }
    .loan-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .loan-icon { font-size: 2rem; margin-bottom: 1rem; }
    .loan-card h3 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--navy); margin-bottom: 0.6rem; }
    .loan-card p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1.1rem; }
    .loan-link { font-size: 0.82rem; font-weight: 700; color: var(--sky); display: inline-flex; align-items: center; gap: 0.3rem; transition: gap 0.15s; }
    .loan-link:hover { gap: 0.5rem; }
    .loan-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
    .loan-tag { font-size: 0.72rem; font-weight: 600; background: var(--sky-light); color: var(--navy); padding: 0.2rem 0.6rem; border-radius: 100px; }
    .zip-section { padding: 5rem 0; background: var(--white); }
    .zip-tabs { display: flex; gap: 0.25rem; margin-bottom: 2.5rem; border-bottom: 2px solid var(--sand-dark); flex-wrap: wrap; }
    .zip-tab { padding: 0.72rem 1.35rem; font-weight: 600; font-size: 0.88rem; cursor: pointer; border: none; background: none; color: var(--text-muted); border-bottom: 3px solid transparent; margin-bottom: -2px; transition: color 0.15s, border-color 0.15s; font-family: var(--font-body); white-space: nowrap; }
    .zip-tab:hover { color: var(--navy); }
    .zip-tab.active { color: var(--navy); border-bottom-color: var(--navy); }
    .zip-panel { display: none; }
    .zip-panel.active { display: block; }
    .zip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
    .zip-info h3 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; color: var(--navy); margin-bottom: 0.75rem; }
    .zip-info p { color: var(--text-muted); line-height: 1.75; margin-bottom: 1rem; font-size: 0.975rem; }
    .zip-info strong { color: var(--text); }
    .stat-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .stat-card { background: var(--sand); border-radius: var(--radius); padding: 1.25rem; border-left: 3px solid var(--navy); }
    .stat-card-value { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; color: var(--navy); line-height: 1; }
    .stat-card-label { font-size: 0.76rem; color: var(--text-muted); margin-top: 0.3rem; font-weight: 500; }
    .neighborhood-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
    .n-tag { background: var(--sky-light); color: var(--navy); font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.72rem; border-radius: 100px; border: 1px solid rgba(74,144,217,0.2); }
    .cta-banner { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%); padding: 4rem 1.5rem; text-align: center; }
    .cta-banner h2 { font-family: var(--font-display); font-size: clamp(1.75rem, 3.5vw, 2.65rem); color: #fff; margin-bottom: 0.75rem; }
    .cta-banner p { color: rgba(255,255,255,0.72); font-size: 1.02rem; margin-bottom: 2rem; max-width: 520px; margin-left: auto; margin-right: auto; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
    .btn-gold { background: var(--gold); color: var(--navy-deep); padding: 0.875rem 2rem; border-radius: 8px; font-weight: 700; font-size: 0.95rem; transition: filter 0.15s, transform 0.15s; display: inline-block; }
    .btn-gold:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .btn-white-outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.45); padding: 0.875rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem; transition: border-color 0.15s; display: inline-block; }
    .btn-white-outline:hover { border-color: #fff; }
    .market-section { padding: 5rem 0; background: var(--sand); }
    .market-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
    .market-card { background: var(--white); border-radius: var(--radius); padding: 1.65rem 1.4rem; box-shadow: var(--shadow); text-align: center; border-top: 4px solid var(--navy); transition: transform 0.2s, box-shadow 0.2s; }
    .market-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
    .market-icon { font-size: 1.75rem; margin-bottom: 0.65rem; }
    .market-value { font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; color: var(--navy); line-height: 1; margin-bottom: 0.3rem; }
    .market-label { font-size: 0.8rem; color: var(--text-muted); font-weight: 500; }
    .market-sub { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sky); margin-top: 0.35rem; }
    .why-local-section { padding: 5rem 0; background: var(--white); }
    .why-local-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
    .why-local-text h2 { font-family: var(--font-display); font-size: clamp(1.9rem, 3.5vw, 2.75rem); font-weight: 700; color: var(--navy); margin-bottom: 1rem; line-height: 1.15; }
    .why-local-text p { color: var(--text-muted); line-height: 1.78; font-size: 0.975rem; margin-bottom: 1.1rem; }
    .why-local-text strong { color: var(--text); }
    .why-local-cards { display: flex; flex-direction: column; gap: 1.1rem; }
    .why-local-card { background: var(--sand); border-radius: var(--radius); padding: 1.4rem 1.5rem; display: flex; gap: 1rem; align-items: flex-start; border-left: 4px solid var(--navy); }
    .why-local-icon { font-size: 1.6rem; flex-shrink: 0; margin-top: 0.1rem; }
    .why-local-card h4 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.3rem; }
    .why-local-card p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.62; margin: 0; }
    .guide-section { padding: 5rem 0; background: var(--sand); }
    .guide-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 4rem; align-items: start; }
    .guide-content h2 { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: var(--navy); margin-bottom: 1.25rem; line-height: 1.2; }
    .guide-content h3 { font-family: var(--font-display); font-size: 1.45rem; font-weight: 700; color: var(--navy); margin: 2rem 0 0.7rem; }
    .guide-content p { color: var(--text-muted); line-height: 1.82; margin-bottom: 1.1rem; font-size: 0.975rem; }
    .guide-content strong { color: var(--text); }
    .guide-content ul { margin: 0.75rem 0 1.25rem 1.25rem; }
    .guide-content ul li { color: var(--text-muted); margin-bottom: 0.5rem; line-height: 1.72; font-size: 0.975rem; }
    .guide-content a { color: var(--sky); text-decoration: underline; text-underline-offset: 2px; }
    .guide-sidebar { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 1.5rem; }
    .sidebar-card { background: var(--white); border-radius: var(--radius); padding: 1.75rem; border: 1px solid var(--sand-dark); }
    .sidebar-card.navy { background: var(--navy); border-color: var(--navy); }
    .sidebar-card h4 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--navy); }
    .sidebar-card.navy h4 { color: #fff; }
    .sidebar-card p { font-size: 0.875rem; line-height: 1.62; color: var(--text-muted); margin-bottom: 1rem; }
    .sidebar-card.navy p { color: rgba(255,255,255,0.78); }
    .btn-navy { background: var(--navy); color: #fff; padding: 0.78rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.875rem; display: inline-block; width: 100%; text-align: center; transition: background 0.15s; margin-bottom: 0.6rem; }
    .btn-navy:hover { background: var(--navy-deep); }
    .btn-gold-full { background: var(--gold); color: var(--navy-deep); padding: 0.78rem 1.5rem; border-radius: 8px; font-weight: 700; font-size: 0.875rem; display: inline-block; width: 100%; text-align: center; transition: filter 0.15s; }
    .btn-gold-full:hover { filter: brightness(1.08); }
    .toc { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .toc a { color: var(--text-muted); font-size: 0.855rem; transition: color 0.15s; display: flex; align-items: center; gap: 0.4rem; }
    .toc a::before { content: '→'; color: var(--sky); font-size: 0.78rem; }
    .toc a:hover { color: var(--navy); }
    .contact-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem; }
    .contact-list a { display: flex; align-items: center; gap: 0.6rem; color: rgba(255,255,255,0.88); font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
    .contact-list a:hover { color: var(--gold); }
    .hoods-section { padding: 5rem 0; background: var(--white); }
    .hoods-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; }
    .hood-card { background: var(--white); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform 0.2s, box-shadow 0.2s; border: 1px solid var(--sand-dark); }
    .hood-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .hood-card-header { background: var(--navy); padding: 1.2rem 1.4rem; display: flex; justify-content: space-between; align-items: flex-start; }
    .hood-name { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: #fff; }
    .hood-badge { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gold); background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.3); padding: 0.22rem 0.55rem; border-radius: 100px; white-space: nowrap; }
    .hood-body { padding: 1.4rem; }
    .hood-price { font-family: var(--font-display); font-size: 1.45rem; font-weight: 700; color: var(--navy); margin-bottom: 0.5rem; }
    .hood-desc { font-size: 0.86rem; color: var(--text-muted); line-height: 1.62; }
    .areas-section { padding: 5rem 0; background: var(--navy); }
    .areas-section .section-label { color: var(--gold); }
    .areas-section .section-title { color: #fff; }
    .areas-section .section-sub { color: rgba(255,255,255,0.72); }
    .areas-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.5rem; }
    .area-card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius); padding: 1.4rem 1.2rem; transition: background 0.2s, border-color 0.2s; }
    .area-card:hover { background: rgba(255,255,255,0.12); border-color: var(--gold); }
    .area-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 0.35rem; }
    .area-zips { font-size: 0.75rem; color: var(--gold); font-weight: 600; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .area-desc { font-size: 0.82rem; color: rgba(255,255,255,0.65); line-height: 1.58; }
    .area-link { font-size: 0.78rem; font-weight: 700; color: var(--gold); display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.75rem; transition: gap 0.15s; }
    .area-link:hover { gap: 0.5rem; }
    .blog-section { padding: 5rem 0; background: var(--sand); }
    .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; }
    .blog-card { background: var(--white); border-radius: var(--radius); padding: 1.75rem; box-shadow: var(--shadow); transition: transform 0.2s, box-shadow 0.2s; border-top: 4px solid var(--sky); }
    .blog-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
    .blog-tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky); margin-bottom: 0.65rem; }
    .blog-card h4 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: var(--navy); margin-bottom: 0.6rem; line-height: 1.3; }
    .blog-card p { font-size: 0.855rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1.1rem; }
    .blog-read { font-size: 0.82rem; font-weight: 700; color: var(--sky); display: inline-flex; align-items: center; gap: 0.3rem; transition: gap 0.15s; }
    .blog-read:hover { gap: 0.5rem; }
    .faq-section { padding: 5rem 0; background: var(--white); }
    .faq-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 4rem; align-items: start; }
    .faq-list { display: flex; flex-direction: column; gap: 0; }
